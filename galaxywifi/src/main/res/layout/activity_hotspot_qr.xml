<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_qr_title"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:contentDescription="@string/widget_qr"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/txtQrSsid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtQrPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="#334155"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnQrClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_scr01_chip"
        android:gravity="center"
        android:text="@string/btn_close"
        android:textColor="#0B57D0"
        android:textStyle="bold" />
</LinearLayout>
