<?xml version="1.0" encoding="utf-8"?>
<!-- Galaxy 5G Mobile Wi‑Fi SCR01 — AP / hotspot (không phải Wi‑Fi client) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scr01_light"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="34dp">

    <!-- Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtWidgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="1"
            android:paddingVertical="2dp"
            android:text="11:30 AM"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtWidgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:clickable="false"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="CN 22/11"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- khoảng trống không nhận click (tránh mở Cài đặt ngoài vùng đồng hồ) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:clickable="false" />

        <ImageView
            android:id="@+id/btnMediaNow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_scr01_chip"
            android:contentDescription="@string/widget_media_now"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_note"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnThemeToggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_scr01_chip"
            android:contentDescription="@string/widget_tile_dark"
            android:padding="5dp"
            android:src="@drawable/ic_theme_dark" />

        <TextView
            android:id="@+id/txtWidgetNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scr01_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="5G"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgSignalBars"
            android:layout_width="30dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_signal" />

        <ImageView
            android:id="@+id/imgBattery"
            android:layout_width="46dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_battery"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Tên mạng — nhấn mở Cài đặt mật khẩu hotspot hệ thống -->
    <LinearLayout
        android:id="@+id/panelCreds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_scr01_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtApLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_net_name"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtWidgetLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hotspot"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtApMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2.4 GHz · OFF"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtPassHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_tap_for_pass"
                android:textColor="#0B57D0"
                android:textSize="12sp" />

            <!-- ẩn: giữ id để binding cũ không lỗi -->
            <TextView
                android:id="@+id/txtPassLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtWidgetPass"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnHotspotToggle"
            android:layout_width="64dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_scr01_chip"
            android:gravity="center"
            android:text="@string/widget_tile_hotspot"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- giữ id btnQr ẩn (RemoteViews / binding cũ) -->
        <ImageView
            android:id="@+id/btnQr"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Connected devices -->
    <LinearLayout
        android:id="@+id/panelClients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_scr01_chip"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/txtClients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_clients_fmt"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shortcuts app — to hơn để dễ nhấn trên cover -->
    <LinearLayout
        android:id="@+id/panelAppShortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_scr01_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/imgFav0"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:contentDescription="@string/app_drawer_title"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgFav1"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgFav2"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgFav3"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/btnTileApps"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_scr01_chip"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/widget_tile_apps"
            android:textColor="#0B57D0"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Meters nhỏ hơn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/panelData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_scr01_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/lblData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_data_month"
                android:textColor="#64748B"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/imgDataMeter"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_data" />

            <TextView
                android:id="@+id/txtWidgetData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 MB"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelSignal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_scr01_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/lblSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_signal_strength"
                android:textColor="#64748B"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/imgSignalMeter"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/widget_signal" />

            <TextView
                android:id="@+id/txtWidgetSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="▮▮▮▯"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- giữ id lịch (ẩn) -->
    <LinearLayout
        android:id="@+id/panelCalendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView android:id="@+id/txtWidgetCalLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txtWidgetCalendar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtWidgetTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="@string/widget_wifi_title" />
</LinearLayout>
