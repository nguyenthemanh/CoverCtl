<?xml version="1.0" encoding="utf-8"?>
<!-- Kính mờ One UI (giả blur: trắng bán trong suốt + viền sáng) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B8FFFFFF"
                android:centerColor="#CCFFFFFF"
                android:endColor="#E6FFFFFF"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
