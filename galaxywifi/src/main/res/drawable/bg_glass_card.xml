<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#18000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B3FFFFFF"
                android:endColor="#F2FFFFFF"
                android:type="linear" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
