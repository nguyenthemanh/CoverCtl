<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#180B57D0" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#99D6E8FF"
                android:endColor="#CCEAF2FF"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#AAFFFFFF" />
        </shape>
    </item>
</layer-list>
