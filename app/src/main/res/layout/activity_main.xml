<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.CoverCtl.LargeTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppSettings"
                    style="@style/Widget.CoverCtl.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/btn_app_settings" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtitle"
                android:textAppearance="@style/TextAppearance.CoverCtl.Body" />

            <!-- Screen modes (flip-ctl parity) -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_screen_mode" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_screen_mode"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtScreenMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeMain"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_main_short" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeCover"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/mode_cover_short" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeDual"
                        style="@style/Widget.CoverCtl.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/mode_dual_short" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeepDual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_keep_dual" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayPerm"
                    style="@style/Widget.CoverCtl.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_overlay_perm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoctor"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_doctor" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtShizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_status_chip_warn"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/shizuku_status_loading"
                android:textColor="@color/ios_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Privilege: ADB vs Shizuku độc lập -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_privilege" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_privilege"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerPrivilege"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mono_panel"
                    android:paddingHorizontal="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoSetup"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_auto_setup" />

                <!-- Panel Shizuku -->
                <LinearLayout
                    android:id="@+id/panelShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShizuku"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shizuku_grant" />
                </LinearLayout>

                <!-- Panel ADB -->
                <LinearLayout
                    android:id="@+id/panelAdb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/editAdbHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mono_panel"
                        android:hint="@string/hint_adb_host"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/editAdbPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_mono_panel"
                        android:hint="@string/hint_adb_port"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/editAdbPairPort"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mono_panel"
                            android:hint="@string/hint_adb_pair_port"
                            android:inputType="number"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editAdbPairCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mono_panel"
                            android:hint="@string/hint_adb_pair_code"
                            android:inputType="number"
                            android:padding="12dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdbPair"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_adb_pair" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdbConnect"
                        style="@style/Widget.CoverCtl.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_adb_connect" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdbDisconnect"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_adb_disconnect" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDevOptions"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_dev_options" />
            </LinearLayout>

            <!-- Logs — gần đầu để thấy trên màn ngoài -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_logs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_logs"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLog"
                    style="@style/TextAppearance.CoverCtl.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mono_panel"
                    android:minHeight="72dp"
                    android:padding="12dp"
                    android:text="" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLog"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_export_log" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareLog"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_share_log" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_log" />
                </LinearLayout>
            </LinearLayout>

            <!-- Identity -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_identity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_identity"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDeviceInfo"
                    style="@style/TextAppearance.CoverCtl.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mono_panel"
                    android:padding="12dp"
                    android:text="@string/device_info_loading" />

                <Spinner
                    android:id="@+id/spinnerProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mono_panel"
                    android:paddingHorizontal="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCoverFull"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_cover_full" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyDisplay"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_apply_display" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplySpoof"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_apply_spoof" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshDevice"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_refresh_device" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareDevice"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_share_device" />
                </LinearLayout>
            </LinearLayout>

            <!-- DeX -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_dex" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_dex"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDexOn"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_dex_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDexStart"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_dex_start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDexSettings"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_dex_settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDexStatus"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_dex_status" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDexOff"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_dex_off" />
            </LinearLayout>

            <!-- Android Auto -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_aa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_aa"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtAaSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/aa_selected_none"
                    android:textColor="@color/ios_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAaChecklist"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_aa_checklist" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAaUnknownAuto"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_aa_unknownauto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAaAnyAuto"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_aa_anyauto" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAaInstallPlay"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_aa_install_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAaUnlock"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_aa_unlock" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAaSettings"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_aa_settings" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAaPick"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_aa_pick" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAaPrepare"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_aa_prepare" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAaStatus"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_aa_status" />
            </LinearLayout>

            <!-- Uninstall apps -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_uninstall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_uninstall"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtUninstallSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/uninstall_selected_none"
                    android:textColor="@color/ios_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstallPick"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_uninstall_pick" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstallPickSystem"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_uninstall_pick_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstallRun"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_uninstall_run" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstallKeepData"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_uninstall_keep_data" />
            </LinearLayout>

            <!-- Cover apps -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_open_on_cover" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/hint_cover_nav"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLauncher"
                        style="@style/Widget.CoverCtl.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_launcher" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettings"
                        style="@style/Widget.CoverCtl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_settings" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreNav"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_restore_nav" />
            </LinearLayout>

            <!-- One Hand / Edge (OHO+ style for cover) -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_one_hand" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_one_hand"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEdgeGestures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_edge_gestures" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEdgeBoth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edge_both" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchShowNavBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_show_nav_bar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyEdgePreset"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_apply_edge_preset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenOho"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_oho" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGoodLock"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_goodlock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenMultistar"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_multistar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableEdgePanel"
                    style="@style/Widget.CoverCtl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_enable_edge_panel" />
            </LinearLayout>

            <!-- Galaxy Wi-Fi 5G widget -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_widget" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_widget"
                    android:textAppearance="@style/TextAppearance.CoverCtl.Body"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtWidgetPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_mono_panel"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="@color/ios_label"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshWidget"
                    style="@style/Widget.CoverCtl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_refresh_widget" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWidgetPerms"
                    style="@style/Widget.CoverCtl.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_widget_perms" />
            </LinearLayout>

            <!-- Scale -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_cover_scale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtDpiValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dpi_value"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekDpi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="200"
                    android:progress="80"
                    android:progressTint="@color/ios_blue"
                    android:thumbTint="@color/ios_blue" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSmall"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNormal"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_normal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLarge"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_large" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnXlarge"
                        style="@style/Widget.CoverCtl.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_xlarge" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDpi"
                    style="@style/Widget.CoverCtl.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_reset_dpi" />
            </LinearLayout>

            <!-- Status -->
            <TextView
                style="@style/TextAppearance.CoverCtl.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_status" />

            <TextView
                android:id="@+id/txtStatus"
                style="@style/TextAppearance.CoverCtl.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:padding="16dp"
                android:text="@string/status_placeholder" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
